# Copy to .env.local and fill in. Never commit .env.local.
# Setup instructions: docs/THIRD_PARTY_SETUP.md

# --- App ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Base URL the Nova server route uses to call /api/v1/chat. Required, no fallback:
# http://localhost:3000 locally, the deployed app's own URL when hosted.
APP_BASE_URL=http://localhost:3000
# Enables demo customer sessions (Walkwave signs in Jane automatically, Nova has a picker).
# Set it to true only where you demo.
ENABLE_DEMO=true

# --- Firebase (firebase-admin service account) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes and the surrounding double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- OpenAI ---
OPENAI_API_KEY=
# Cheapest current "mini" chat model from the OpenAI pricing page
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Email (Gmail SMTP with an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox that demo customers' emails go to
DEMO_EMAIL_TO=
# Comma-separated addresses a customer may name explicitly in chat
EMAIL_ALLOWLIST=

# --- Demo seed (used by npm run seed) ---
# Generate long random values; used to create admin accounts and the Nova API key
WALKWAVE_ADMIN_PASSWORD=
NOVA_ADMIN_PASSWORD=
NOVA_DEMO_API_KEY=
