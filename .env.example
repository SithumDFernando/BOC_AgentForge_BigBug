# Copy to .env.local and fill in. Never commit .env.local.
# Setup instructions: docs/THIRD_PARTY_SETUP.md. On Cloud Run the same names are
# set with --set-env-vars, and the secrets come from Secret Manager.

# --- App ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Base URL the Nova server route uses to call /api/v1/chat, and the widget snippet's host.
# Required, no fallback: http://localhost:3000 locally, the Cloud Run URL when deployed.
APP_BASE_URL=http://localhost:3000
# Enables demo customer sessions (Walkwave signs in Jane automatically, Nova has a picker).
# Set it to true only where you demo.
ENABLE_DEMO=true
# "off" makes the assistant use the deterministic rules instead of model tool calls (stage switch).
AGENT_TOOLS=on

# --- Google Cloud / Firebase ---
# Locally, run `gcloud auth application-default login` and leave FIREBASE_CLIENT_EMAIL and
# FIREBASE_PRIVATE_KEY empty: Firestore and Vertex AI then use Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Only if you use a service-account key: keep the \n escapes and the surrounding double quotes
FIREBASE_PRIVATE_KEY=

# --- Model (lib/llm.ts) ---
# vertex (default) or openai. Switching means re-indexing documents (npm run seed re-indexes the seeded ones).
LLM_PROVIDER=vertex
# A region where both models are offered (asia-south1 if listed), or global
VERTEX_LOCATION=
# Current Gemini Flash model and a text-embedding model with 768-dimension output, from Model Garden
VERTEX_MODEL=
VERTEX_EMBEDDING_MODEL=
# Optional: "openai" retries chat generation on OpenAI when Vertex AI fails (embeddings never fall back)
LLM_FALLBACK=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Email (Gmail SMTP with an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox that demo customers' emails go to
DEMO_EMAIL_TO=
# Comma-separated addresses a customer may name explicitly in chat
EMAIL_ALLOWLIST=

# --- Demo seed (used by npm run seed) ---
# Generate long random values; used to create admin accounts and the Nova API key
WALKWAVE_ADMIN_PASSWORD=
NOVA_ADMIN_PASSWORD=
NOVA_DEMO_API_KEY=
